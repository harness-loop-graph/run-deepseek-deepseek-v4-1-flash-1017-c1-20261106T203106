    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "multer": "1.4.5-lts.1",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "20.17.10",
    "@types/pg": "8.11.10",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
