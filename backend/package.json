{
  "name": "medapp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Medical appointments and clinical history registry - NestJS REST API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
